# Copy to apps/web/.env.local and fill in. Never commit real values.

# Local development database (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5452/sharkly_dev

# Shared secret the scheduler sends to /api/cron/* (32+ random characters)
CRON_SECRET=replace-with-at-least-32-random-characters

# Signs sessions and tokens (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The public address of the site, no trailing slash
BETTER_AUTH_URL=http://localhost:3500

# Email. Leave RESEND_API_KEY unset locally and emails are printed to the log instead.
# It is required in production.
# RESEND_API_KEY=re_replace_me
EMAIL_FROM=Sharkly <hello@example.com>

# Hosting only. Search engines are told to ignore the site until this is "true".
# ALLOW_INDEXING=false

# Hosting only. The most database connections each server instance keeps open (default 10).
# DATABASE_POOL_MAX=5
